{
  "name": "iot-fota-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "bun --filter api start:dev",
    "dev:ui": "bun --filter frontend dev",
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "test": "bun test --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "^25.5.0",
    "bun-workspaces": "^1.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8"
  }
}